    "watch:dev": "vite build --watch --mode development",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "sass": "^1.104.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
