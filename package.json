{
  "name": "autofill",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Open source autofill extension for Shopify, Supreme, Stripe and Shopee Malaysia",
  "author": "Alex.#4321",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "build:dev": "vue-tsc --noEmit && vite build --mode development",
